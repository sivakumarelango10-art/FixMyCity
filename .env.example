# ------------------------------------------------------------------
# FixMyCity environment configuration
# Copy to .env (repo root) and adjust. Never commit real secrets.
# ------------------------------------------------------------------

# --- Database (PostgreSQL) ---------------------------------------
# Which environment this configuration describes: local | staging | production.
# Seeding and destructive database scripts consult this, not NODE_ENV alone.
APP_ENV=local

# Local dev cluster created by `npm run db:local:init` listens on 5433.
DATABASE_URL="postgresql://fixmycity:fixmycity_dev_pw@localhost:5433/fixmycity?schema=public"
# Connection used by Prisma migrations. Locally identical to DATABASE_URL.
DIRECT_URL="postgresql://fixmycity:fixmycity_dev_pw@localhost:5433/fixmycity?schema=public"
# Separate database used by the API integration tests (it is wiped on every run).
TEST_DATABASE_URL="postgresql://fixmycity:fixmycity_dev_pw@localhost:5433/fixmycity_test?schema=public"

# --- API server ---------------------------------------------------
NODE_ENV=development
API_PORT=4000
# Browser origin(s) allowed by CORS and Socket.IO, comma separated.
WEB_ORIGIN=http://localhost:3000
# Long random string. Signs short-lived realtime tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string
SESSION_TTL_HOURS=168
# Set to true behind HTTPS in production (adds the Secure cookie flag).
COOKIE_SECURE=false
# Set to true when running behind a reverse proxy / load balancer.
TRUST_PROXY=false
LOG_LEVEL=info

# --- File storage -------------------------------------------------
# supabase: Supabase Storage bucket (complaint-photos)
# local:    files on disk (development only)
# s3:       S3-compatible object store
STORAGE_DRIVER=supabase
UPLOAD_DIR=uploads
SUPABASE_STORAGE_BUCKET=complaint-photos
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- AI classification (Gemini & Anthropic) ------------------------
# AI provider: gemini | anthropic | auto
AI_PROVIDER=gemini
# Gemini API Key from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=
GOOGLE_API_KEY=
# Anthropic API Key (optional fallback)
ANTHROPIC_API_KEY=
# AI model: gemini-2.5-flash (default), gemini-2.0-flash, gemini-1.5-flash, etc.
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=10000

# --- Email (optional, used for password reset) -------------------
# Without SMTP the API logs reset links to its console in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FixMyCity <no-reply@fixmycity.local>"

# --- Web app (apps/web) -------------------------------------------
# Where the Next.js server reaches the API (rewrites + server components).
API_INTERNAL_URL=http://localhost:4000
# Where the browser opens the realtime socket.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

