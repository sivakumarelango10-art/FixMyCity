# ------------------------------------------------------------------
# FixMyCity cloud (Supabase) database template.
# Copy to .env.cloud (git-ignored), fill in values from your Supabase
# project (Connect button > ORMs > Prisma), then run cloud commands with:
#
#   node scripts/with-env.mjs .env.cloud -- npm run db:deploy
#   node scripts/with-env.mjs .env.cloud -- npm run db:status
#
# Never commit real values. Hosting providers (Railway, Vercel) should get
# these as secrets in their dashboards instead of a file.
# ------------------------------------------------------------------

APP_ENV=staging

# Long-running Express server: Supavisor session pooler on port 5432.
# Supabase recommends a dedicated "prisma" database role (see docs/DATABASE.md).
DATABASE_URL="postgresql://prisma.<PROJECT-REF>:<PRISMA-PASSWORD>@<REGION>.pooler.supabase.com:5432/postgres?sslmode=require"

# Migrations: session pooler (above) or the direct host if you have IPv6 / the IPv4 add-on.
DIRECT_URL="postgresql://prisma.<PROJECT-REF>:<PRISMA-PASSWORD>@<REGION>.pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase Storage through its S3-compatible API (Storage > Settings > S3 connection).
# Keys bypass Row Level Security and must stay on the server.
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<PROJECT-REF>.storage.supabase.co/storage/v1/s3
S3_REGION=<PROJECT-REGION>
S3_BUCKET=complaint-photos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
