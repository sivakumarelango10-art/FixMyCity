# ==============================================================================
# FixMyCity - Environment Configuration Template (.env.example)
#
# Active Local Development Stack:
#   - Database & ORM: PostgreSQL, Prisma
#   - Backend: Express.js (Port 4000)
#   - Frontend: Next.js (Port 3000)
#   - Session Auth: HMAC-signed session cookies (SESSION_SECRET)
#   - File Storage: Supabase Storage (complaint-photos bucket)
#   - AI Classifier: Google Gemini (gemini-2.5-flash)
#   - Realtime Updates: Socket.IO (Port 4000)
#
# Instructions:
#   Copy this file to .env at the repository root and fill in your values.
#   Never commit real secrets or credentials to source control.
# ==============================================================================

# --- Database & Migrations (PostgreSQL & Prisma) ------------------------------
# Deployment target indicator: 'local' for local development
APP_ENV=local

# Primary database connection string for Prisma client and runtime queries (local dev cluster on 5433)
DATABASE_URL="postgresql://fixmycity:fixmycity_dev_pw@localhost:5433/fixmycity?schema=public"

# Direct database connection string used by Prisma migrations (npm run db:deploy)
DIRECT_URL="postgresql://fixmycity:fixmycity_dev_pw@localhost:5433/fixmycity?schema=public"

# Isolated test database connection string (prevents accidental deletion of development data)
TEST_DATABASE_URL="postgresql://fixmycity:fixmycity_dev_pw@localhost:5433/fixmycity_test?schema=public"

# --- Backend API (Express.js) -------------------------------------------------
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Cryptographic signing secret for sessions (must be at least 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long
SESSION_TTL_HOURS=168

# --- File Storage (Supabase Storage) -----------------------------------------
STORAGE_DRIVER=supabase
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase Secret / Service Role Key (used securely on backend for bucket storage)
SUPABASE_SECRET_KEY=your_supabase_secret_or_service_role_key
SUPABASE_STORAGE_BUCKET=complaint-photos

# --- AI Classification (Google Gemini) ---------------------------------------
AI_PROVIDER=gemini
# Gemini API Key from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash

# --- Web Frontend (Next.js) & Real-time Updates -------------------------------
# Internal URL where Next.js server components and rewrites reach Express
API_INTERNAL_URL=http://localhost:4000

# Public URL for the browser to establish Socket.IO realtime connection
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Canonical application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public Supabase credentials for client-side authentication and storage access
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
